	"tokenColors": [
		{
			"scope": [
				"comment",
				"comment.block",
				"comment.line",
				"comment.doc"
			],
			"settings": {
				"foreground": "#9A9A9A",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"constant",
				"constant.language",
				"constant.other",
				"constant.character.escape",
				"string.interpolated.special",
				"string.special",
				"string.special.symbol"
			],
			"settings": {
				"foreground": "#0E7A69"
			}
		},
		{
			"scope": [
				"constant.numeric"
			],
			"settings": {
				"foreground": "#404055"
			}
		},
		{
			"scope": [
				"constant.language.boolean",
				"entity.name.tag"
			],
			"settings": {
				"foreground": "#8A6800"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"support.function"
			],
			"settings": {
				"foreground": "#7A5000"
			}
		},
		{
			"scope": [
				"entity.name.function.constructor"
			],
			"settings": {
				"foreground": "#7A5000"
			}
		},
		{
			"scope": [
				"variable.member"
			],
			"settings": {
				"foreground": "#404055"
			}
		},
		{
			"scope": [
				"keyword",
				"storage",
				"storage.type",
				"storage.modifier"
			],
			"settings": {
				"foreground": "#0E7A69"
			}
		},
		{
			"scope": [
				"variable.language.this"
			],
			"settings": {
				"foreground": "#0E7A69"
			}
		},
		{
			"scope": [
				"variable",
				"variable.parameter",
				"variable.other"
			],
			"settings": {
				"foreground": "#5845B0"
			}
		},
		{
			"scope": [
				"variable.language",
				"variable.other.special",
				"variable.special"
			],
			"settings": {
				"foreground": "#342C50"
			}
		},
		{
			"scope": [
				"variable.other.property",
				"support.type.property-name",
				"meta.object-literal.key",
				"variable.object.property",
				"punctuation",
				"punctuation.bracket",
				"punctuation.delimiter",
				"punctuation.list_marker",
				"punctuation.special",
				"operator",
				"number"
			],
			"settings": {
				"foreground": "#404055"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"support.type",
				"support.class",
				"entity.name.class",
				"type"
			],
			"settings": {
				"foreground": "#1A60B0"
			}
		},
		{
			"scope": [
				"entity.other.attribute-name",
				"attribute"
			],
			"settings": {
				"foreground": "#5845B0",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"string"
			],
			"settings": {
				"foreground": "#A82888"
			}
		},
		{
			"scope": [
				"string.escape",
				"string.special"
			],
			"settings": {
				"foreground": "#A05010"
			}
		},
		{
			"scope": [
				"string.regexp",
				"string.regex"
			],
			"settings": {
				"foreground": "#A80055"
			}
		},
		{
			"scope": [
				"markup.heading",
				"heading"
			],
			"settings": {
				"foreground": "#1A60B0",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.literal",
				"text.literal"
			],
			"settings": {
				"foreground": "#446600"
			}
		}
	],
	"semanticHighlighting": true
}
