{
  "compilerOptions": {
    "module": "CommonJS",
    "target": "es2019",
    "lib": [
      "ES2019",
      "DOM"
    ],
    "sourceMap": true,
    "strict": true,
    "rootDir": "src",
    "outDir": "out",
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "typeRoots": [
      "../../src/vscode-dts",
      "../../node_modules/@types"
    ]
  },
  "exclude": [
    "node_modules",
    ".vscode-test",
    "sandbox"
  ]
}
