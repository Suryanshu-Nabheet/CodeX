{
  "name": "codex-commit",
  "displayName": "CodeX Auto Commit",
  "description": "CodeX Auto Commit Extension used across the IDE",
  "version": "0.0.1",
  "publisher": "Suryanshu-Nabheet",
  "author": {
    "name": "Suryanshu Nabheet"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Suryanshu-Nabheet/CodeX.git"
  },
  "bugs": {
    "url": "https://github.com/Suryanshu-Nabheet/CodeX/issues"
  },
  "homepage": "https://github.com/Suryanshu-Nabheet/codex#readme",
  "license": "MIT",
  "engines": {
    "vscode": "^1.103.0"
  },
  "extensionDependencies": [
    "vscode.git"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p .",
    "watch": "tsc -watch -p ."
  },
  "devDependencies": {
    "@types/node": "^22.00.00",
    "typescript": "^5.0.4"
  },
  "categories": [
    "SCM Providers"
  ],
  "icon": "images/icon.png",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "codex.autofill",
        "title": "CodeX Auto Commit",
        "icon": {
          "dark": "images/message.svg",
          "light": "images/message-light.svg"
        }
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "codex.autofill",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ]
    }
  }
}
