{
  "name": "codexcli",
  "version": "1.0.0",
  "description": "CodexCLI — autonomous terminal AI coding agent",
  "author": "Suryanshu Nabheet",
  "homepage": "https://github.com/Suryanshu-Nabheet/CodeX",
  "bugs": {
    "url": "https://github.com/Suryanshu-Nabheet/CodeX/issues"
  },
  "bin": {
    "codexcli": "bin/codexcli.js"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "format": "prettier --check src",
    "format:fix": "prettier --write src",
    "dev": "tsc --watch",
    "lint": "eslint src --ext ts --ext tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src --ext ts --ext tsx --fix",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --noEmit",
    "build": "node build.mjs",
    "build:dev": "NODE_ENV=development node build.mjs --dev && NODE_OPTIONS=--enable-source-maps node dist/cli-dev.js",
    "stage-release": "./scripts/stage_release.sh",
    "setup": "./scripts/setup.sh",
    "dev:link": "./scripts/dev.sh",
    "setup:env": "./scripts/setup_env.sh"
  },
  "files": [
    "bin",
    "dist"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.33.1",
    "@google/generative-ai": "^0.21.0",
    "@inkjs/ui": "^2.0.0",
    "chalk": "^5.2.0",
    "cli-highlight": "^2.1.11",
    "diff": "^7.0.0",
    "dotenv": "^16.1.4",
    "fast-deep-equal": "^3.1.3",
    "fast-npm-meta": "^0.4.2",
    "figures": "^6.1.0",
    "file-type": "^20.1.0",
    "https-proxy-agent": "^7.0.6",
    "ink": "^5.2.0",
    "js-yaml": "^4.1.0",
    "marked": "^15.0.7",
    "marked-terminal": "^7.3.0",
    "meow": "^13.2.0",
    "openai": "^4.95.1",
    "package-manager-detector": "^1.2.0",
    "react": "^18.2.0",
    "shell-quote": "^1.8.2",
    "strip-ansi": "^7.1.0",
    "to-rotated": "^1.0.0",
    "use-interval": "1.4.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/js-yaml": "^4.0.9",
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^25.0.8",
    "@types/react": "^19.2.0",
    "@types/shell-quote": "^1.7.5",
    "@types/which": "^3.0.4",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "boxen": "^8.0.1",
    "esbuild": "^0.25.2",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "prettier": "^3.5.3",
    "semver": "^7.7.1",
    "typescript": "~5.5.4",
    "vite": "^6.3.4",
    "vitest": "^3.1.2",
    "which": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Suryanshu-Nabheet/CodeX.git"
  }
}
